{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entity Schema",
  "description": "Schema for entities in the criminal network knowledge graph",
  "type": "object",
  "required": ["id", "name", "entity_type"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the entity"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Display name of the entity"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Person", "Organization", "Location", "PhoneNumber", 
        "Email", "BankAccount", "Vehicle", "SocialHandle", 
        "Event", "Document", "CryptoWallet", "IdNumber"
      ],
      "description": "Type classification of the entity"
    },
    "properties": {
      "type": "object",
      "description": "Flexible key-value properties specific to entity type",
      "additionalProperties": true
    },
    "source_documents": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of source document IDs that reference this entity"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1.0,
      "description": "Confidence score for entity extraction"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Calculated risk score"
    },
    "centrality_scores": {
      "type": "object",
      "properties": {
        "pagerank": {"type": "number"},
        "betweenness": {"type": "number"},
        "closeness": {"type": "number"},
        "eigenvector": {"type": "number"}
      },
      "description": "Network centrality metrics"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}